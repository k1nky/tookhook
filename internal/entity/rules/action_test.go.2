package rules

import (
	"testing"

	"github.com/k1nky/tookhook/internal/entity"
	"github.com/k1nky/tookhook/internal/entity/hooks"
	"github.com/k1nky/tookhook/pkg/thstrings"
	"github.com/k1nky/tookhook/pkg/thstrings/tstrings"
	"github.com/stretchr/testify/assert"
)

func TestActions_Execute(t *testing.T) {
	tests := []struct {
		name       string
		a          Actions
		h          *hooks.Hook
		wantError  error
		wantResult []byte
	}{
		{
			name: "Not match",
			h: &hooks.Hook{
				RawBody: []byte(`{"@timestamp": "2024-07-11T12:40:31.574Z", "level": "INFO", "port": 37628, "host.name": "hostname", "message": "Select 1", "type": "app_log"}`),
			},
			wantError:  entity.ErrNotMatch,
			wantResult: []byte(`{"@timestamp": "2024-07-11T12:40:31.574Z", "level": "INFO", "port": 37628, "host.name": "hostname", "message": "Select 1", "type": "app_log"}`),
			a: Actions{
				&Action{
					On: *tstrings.New(`{{ . | ifMatch "NOT_MATCH" }}`),
				},
			},
		},
		{
			name: "Discard",
			h: &hooks.Hook{
				RawBody: []byte(`{"name": "Name", "data": "My Data"}`),
			},
			wantError: entity.ErrDiscard,
			a: Actions{
				&Action{
					Type: ActionTypeDiscard,
				},
			},
		},
	}
	for _, tt := range tests {
		t.Run(tt.name, func(t *testing.T) {
			tt.a.Compile()
			got, err := tt.a.Execute(tt.h)
			assert.ErrorIs(t, err, tt.wantError, tt.name)
			assert.Equal(t, tt.wantResult, got, tt.name)
		})
	}
}

func TestActions_Compile(t *testing.T) {
	tests := []struct {
		name      string
		a         Actions
		wantError error
	}{
		{
			name: "Empty actions",
			a: Actions{
				&Action{},
			},
		},
		{
			name: "Invalid On value",
			a: Actions{
				&Action{
					On: *tstrings.New("{{}"),
				},
			},
			wantError: thstrings.ErrCompile,
		},
		{
			name: "Valid On value",
			a: Actions{
				&Action{
					On: *tstrings.New(".*"),
				},
			},
		},
	}
	for _, tt := range tests {
		t.Run(tt.name, func(t *testing.T) {
			got := tt.a.Compile()
			assert.ErrorIs(t, got, tt.wantError, tt.name)
		})
	}

}
